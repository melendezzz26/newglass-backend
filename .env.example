DATABASE_URL=postgresql+psycopg://newglass_example:not-a-real-password@127.0.0.1:5432/newglass_example
# Generar una clave propia fuera de Git; vacío intencionalmente (no permite arrancar).
SECRET_KEY=
TOKEN_MINUTOS=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcionales PostgreSQL: descomentar y completar solo tras elegir límites.
# No son límites recomendados ni verificados para Supabase.
# DB_POOL_SIZE=<entero mayor o igual a 1>
# DB_MAX_OVERFLOW=<entero mayor o igual a 0>
# DB_POOL_TIMEOUT=<segundos enteros mayor o igual a 1>
# DB_CONNECT_TIMEOUT=<segundos enteros mayor o igual a 1>
# Staging: DATABASE_URL externa con TLS según endpoint (sslmode=require si corresponde).

# Comparador v2: opcionales, los tres límites deben establecerse juntos.
# Perfil experimental Basic 512 MiB, medido con figuras sintéticas repetidas.
# No cambia los límites nativos de M6, tiempos, geometría ni inventario.
# NEWGLASS_COMPARISON_SUPERVISOR_MIB=280
# NEWGLASS_COMPARISON_WORKER_MIB=128
# NEWGLASS_COMPARISON_AGGREGATE_MIB=448
# NEWGLASS_DYNO_MEMORY_MIB=512
# Sin los tres overrides se conservan 240/256/1024 MiB respectivamente.

# EN-SEC-001: límite de intentos de login, por cuenta y por IP (enteros >= 1).
# Sin definirlas rigen 5 fallos en 15 minutos => 15 minutos de bloqueo (HTTP 429).
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15
# Detrás de un proxy (Heroku), Uvicorn solo usa X-Forwarded-For si la conexión
# llega desde una IP confiable (FORWARDED_ALLOW_IPS); ver SPEC-EN-SEC-001 D-07.

# EN-CONC-001: espera durable V2 (1..100), un supervisor (1) o despacho pausado (0).
# NEWGLASS_COMPARISON_QUEUE_CAPACITY=8
# NEWGLASS_COMPARISON_MAX_ACTIVE=1
